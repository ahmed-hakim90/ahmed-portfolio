# Copy variable NAMES into Vercel → Project → Settings → Environment Variables.
# Paste VALUES only in Vercel (or .env.local locally). Never commit real secrets.

# --- Required on Vercel ---
# Random string, at least 16 characters (signs admin session JWT).
ADMIN_DASHBOARD_SECRET=

# Firebase Admin (server only) — from the same service account JSON in Firebase Console:
# Project settings → Service accounts → Generate new private key (use fields from that JSON).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full private key; on Vercel literal \n in the string becomes real newlines via the app.
FIREBASE_PRIVATE_KEY=

# --- Recommended ---
# Public site URL, no trailing slash (metadata / absolute URLs).
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# --- Optional ---
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
SIGNUP_INVITE_SECRET=
