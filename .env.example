# Copy variable NAMES into Vercel → Project → Settings → Environment Variables.
# Paste VALUES only in Vercel (or .env.local locally). Never commit real secrets.

# --- Required on Vercel ---
# Random string, at least 16 characters (signs admin session JWT).
ADMIN_DASHBOARD_SECRET=

# Full Firebase service account JSON as a single line (minified).
# The "private_key" value must use \n for line breaks inside the string, not real newlines.
# Remove FIREBASE_SERVICE_ACCOUNT_PATH on Vercel if you use this (no file on serverless disk).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Recommended ---
# Public site URL, no trailing slash (metadata / absolute URLs).
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Optional: public slug of the admin user who owns the default /portfolio site.
# Required for saving contact form messages from that page (not needed for /[slug] portfolios).
CONTACT_SITE_OWNER_SLUG=

# --- Client Firebase (required for Auth: email + Google in the browser) ---
# From Firebase Console → Project settings → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional but recommended (same config snippet):
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# --- Admin image uploads via Google Drive (required for /api/admin/uploads) ---
# Service account email from Google Cloud IAM.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=hakimo-cv@eastern-robot-246200.iam.gserviceaccount.com
