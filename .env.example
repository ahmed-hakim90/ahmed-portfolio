# Existing Drive folder id used as root; grant Editor access to the service account.
GOOGLE_DRIVE_ROOT_FOLDER_ID=1ZWDOAa7XQPUhv3DQd7gfXyXPbHwhm23I
# Optional: delegated user email if using Workspace domain-wide delegation.
GOOGLE_DRIVE_IMPERSONATE_USER=

# --- Optional ---
# Invite-only public signup: set to a secret string; signup must send this as inviteCode.
SIGNUP_INVITE_SECRET=
# First owner bootstrap (see /dashboard/bootstrap): either set a single secret (preferred)
# OR use username + password pair below (must match what you send in the bootstrap form).
ADMIN_BOOTSTRAP_SECRET=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Local development only (do not set on Vercel) ---
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# In Console: Authentication → Sign-in method → enable Email/Password and Google;
# add your domains under Authentication → Settings → Authorized domains.
